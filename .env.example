# Polar API Credentials
# Register your application at https://admin.polaraccesslink.com/
POLAR_CLIENT_ID=your_polar_client_id
POLAR_CLIENT_SECRET=your_polar_client_secret

# Garmin Connect Credentials
GARMIN_EMAIL=your_garmin_email
GARMIN_PASSWORD=your_garmin_password

# Sync Settings
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=30
DEFAULT_ACTIVITY_TYPE=other
